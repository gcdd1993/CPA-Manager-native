{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CPA Manager Native",
  "version": "0.0.6",
  "identifier": "com.cpamanager.native",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CPA Manager Native",
        "width": 1280,
        "height": 820,
        "minWidth": 780,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/gcdd1993/CPA-Manager-native/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwNjRCQkM1RUVBNjgzMUYKUldRZmc2YnV4YnRrOERadVMzalNWaXhGRUduMmhOMEFpbGFWRUhFbUZVMy8veUJTMGhSazhFNVAK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
